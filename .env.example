# Phase 1a 단일 노드 compose(compose/) 설정 견본. 쓰려면 이 파일을 .env 로 복사한다 (.env 는 레포에 올라가지 않는다).
# 1b 이후 EKS 환경의 비밀값은 여기가 아니라 AWS Secrets Manager 에 두고 apps/*/values-*.yaml 에는 이름만 적는다.
# 실제 운영 비밀값은 절대 넣지 않는다.

# 이미지 (CI 봇이 갱신하는 image.tag 와 같은 값)
# 기본 ghcr.io/2026-techeer-project-team-b 또는 ECR 주소
IMAGE_REGISTRY=
# 기본 latest
IMAGE_TAG=

# 인프라 계정 (compose 가 Kafka · ClickHouse · PostgreSQL · MySQL 을 함께 띄울 때 쓴다)
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
POSTGRES_USER=
POSTGRES_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
